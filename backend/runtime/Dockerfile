# ARM64 Python base from ECR Public, the same base and tag as the other service images; AgentCore
# Runtime runs ARM64 containers. Base-image digest pinning is a pending decision (SI-4).
# https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/getting-started-custom.html

# Build stage: generate the Pydantic models from the OpenAPI schema (api-schema.yaml is staged by
# deployment/deploy_backend.py runtime_source). Only the generated module reaches the runtime stage, so the
# generator and its formatters never ship in the image.
FROM --platform=linux/arm64 public.ecr.aws/docker/library/python:3.14-slim-trixie AS models
WORKDIR /build
ENV UV_SYSTEM_PYTHON=1
COPY requirements-lock.txt ./
RUN pip install --no-cache-dir --only-binary=:all: --constraint requirements-lock.txt uv==0.11.29 \
    && uv pip install --no-cache --constraint requirements-lock.txt datamodel-code-generator==0.82.0
COPY schemas/api-schema.yaml /tmp/api-schema.yaml
RUN mkdir -p schemas && \
    python -m datamodel_code_generator \
        --input /tmp/api-schema.yaml \
        --output schemas/generated_models.py \
        --output-model-type pydantic_v2.BaseModel \
        --field-constraints \
        --use-standard-collections && \
    echo "✅ Generated Pydantic models from api-schema.yaml"

FROM --platform=linux/arm64 public.ecr.aws/docker/library/python:3.14-slim-trixie
WORKDIR /app
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

# UV configuration for container
ENV UV_SYSTEM_PYTHON=1 UV_COMPILE_BYTECODE=1

# Install uv from its exact pin (the lock constrains it as well), then the locked Python dependencies.
COPY requirements.txt requirements-lock.txt ./
RUN pip install --no-cache-dir --only-binary=:all: --constraint requirements-lock.txt uv==0.11.29 \
    && uv pip install --no-cache --constraint requirements-lock.txt -r requirements.txt

# The models generated by the build stage; check_startup.py uses them instead of generating its own.
COPY --from=models /build/schemas/generated_models.py schemas/generated_models.py

# ---------------------------------------------------------------------------
# Runtime environment
# ---------------------------------------------------------------------------

# Container indicator (used by binding logic in some libraries)
ENV DOCKER_CONTAINER=1

# AgentCore Runtime reaches the AG-UI server on port 8080, so the image binds every interface.
# Local runs bind 127.0.0.1 unless AGENT_HOST is set (wfm_agui_entrypoint.bind_host).
ENV AGENT_HOST=0.0.0.0

# Force unbuffered stdout/stderr so print() / logging reach CloudWatch immediately.
ENV PYTHONUNBUFFERED=1

# Tell the env_loader to skip local .env and rely solely on the env vars that
# the AgentCore Runtime resource (CloudFormation) injects at container start.
# This prevents drift between baked-in .env and CFN-managed configuration.
ENV AGENTCORE_RUNTIME=true

# OTel auto-instrumentation: keep most instrumentations but disable the Bedrock
# stream instrumentations because they break ConverseStream.
ENV OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=bedrock,bedrock-runtime

# ---------------------------------------------------------------------------
# Application code
# ---------------------------------------------------------------------------

# Copy the rest of the runtime code. Honour .dockerignore.
COPY . .

# Drop privileges. (Order matters: COPY before USER so files are owned by root,
# which is fine for read-only execution by the unprivileged user.)
RUN useradd -m -u 1000 bedrock_agentcore
USER bedrock_agentcore

# AG-UI / HTTP protocol port for AgentCore Runtime
EXPOSE 8080

# AgentCore Runtime healthcheck calls GET /ping on port 8080.
# We keep a Docker-level healthcheck for local docker run too.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request, sys; \
sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/ping', timeout=3).status == 200 else 1)" || exit 1

# Launch the AG-UI FastAPI app under ADOT auto-instrumentation
CMD ["opentelemetry-instrument", "python", "-m", "wfm_agui_entrypoint"]
