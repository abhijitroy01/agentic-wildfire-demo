# =============================================================================
# Radio (Broadcastify) settings for a local run
# =============================================================================
# Copy this file to broadcastify/.env; shared/config.py reads only that file.
# It lists every setting the radio code reads, and nothing else
# (deployment/tests/test_env_examples.py checks it). Commented settings are
# optional and show the code's default. The deployed radio task gets its
# variables from the stack (deployment/infra/lib/stacks.ts) and has no .env.

# =============================================================================
# AWS and storage (required: AWS_REGION, S3_BUCKET)
# =============================================================================
AWS_REGION=us-west-2
S3_BUCKET=your-s3-bucket-name
# Presigned URL expiry for recording playback, in seconds
PRESIGNED_URL_EXPIRY_SECONDS=3600

# =============================================================================
# Service key (required: API_KEY)
# =============================================================================
# Shared key of the radio service. The service refuses to start without a key
# of at least 32 characters; the workspace API sends it as a Bearer header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# =============================================================================
# Recorded-audio investigation (the deployed service; required: MONITOR_BEDROCK_MODEL_ID)
# =============================================================================
# Fast model for location extraction from transcripts. A global cross-Region
# inference profile ID works in any Region and account:
# https://docs.aws.amazon.com/bedrock/latest/userguide/inference-profiles-use.html
MONITOR_BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# MONITOR_MODEL_MAX_TOKENS=512
# MONITOR_MODEL_TEMPERATURE=0.0

# Recordings to replay: S3 keys, or prefixes ending in "/" for every MP3 under them
MONITOR_TEST_FILES=input/LA_County_Fire_v1_2025-01-10/
# Replay speed in times real time; the S3 source caps it at 4 so Transcribe keeps up
# RADIO_REPLAY_SPEED=3.0

# Fire detection keywords and the phrases that rule a transmission out
FIRE_KEYWORDS=wildfire,brush fire,vegetation fire,structure fire,fire,evacuation,evacuate,smoke,flames,threatening structures,wind driven
EXCLUSION_PATTERNS=training,exercise,drill,false alarm,controlled burn,prescribed fire

# PCM chunk duration in milliseconds; lower values mean lower latency but more overhead
MONITOR_PCM_CHUNK_MS=100
# Transcript window searched for keywords (seconds)
MONITOR_TRANSCRIPT_WINDOW_SECONDS=15
# Window in which a repeated location counts as the same detection (minutes)
MONITOR_DEDUP_WINDOW_MINUTES=5
# Location extraction cache size
MONITOR_LOCATION_CACHE_SIZE=100
# Lowest detection confidence that is reported
MONITOR_CONFIDENCE_THRESHOLD=0.5
# MP3 bitrate (bits/second) assumed when ffprobe cannot read a file's own:
# 32000 = Broadcastify dispatch feeds (32 kbps mono), 128000 = music-quality MP3
MONITOR_DEFAULT_MP3_BITRATE_BPS=32000

# Amazon Transcribe streaming language
TRANSCRIBE_LANGUAGE_CODE=en-US
# Custom vocabulary for domain terms, created with `aws transcribe create-vocabulary`.
# The streaming transcription passes it to Transcribe. Leave blank to use the
# base model only.
TRANSCRIBE_VOCABULARY_NAME=
# Streaming partial-result stability: high, medium or low. `medium` suits noisy
# radio audio; any other value leaves stabilization off.
TRANSCRIBE_PARTIAL_STABILITY=medium
