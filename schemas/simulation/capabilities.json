  "scenario_schema": {
    "additionalProperties": false,
    "description": "The integration boundary requires explicit geographic/profile choices.",
    "properties": {
      "background_speed_factor": {
        "default": 1.0,
        "maximum": 1.0,
        "minimum": 0.3,
        "title": "Background Speed Factor",
        "type": "number"
      },
      "crews": {
        "default": 4,
        "maximum": 16,
        "minimum": 0,
        "title": "Crews",
        "type": "integer"
      },
      "departure_minutes": {
        "default": 10,
        "maximum": 45,
        "minimum": 1,
        "title": "Departure Minutes",
        "type": "integer"
      },
      "duration_minutes": {
        "default": 30,
        "maximum": 60,
        "minimum": 5,
        "title": "Duration Minutes",
        "type": "integer"
      },
      "exit_direction": {
        "enum": [
          "south",
          "north",
          "east",
          "west"
        ],
        "title": "Exit Direction",
        "type": "string"
      },
      "hazard_growth_m_min": {
        "default": 10,
        "maximum": 100,
        "minimum": 0,
        "title": "Hazard Growth M Min",
        "type": "number"
      },
      "hazard_radius_m": {
        "default": 150,
        "maximum": 3000,
        "minimum": 0,
        "title": "Hazard Radius M",
        "type": "number"
      },
      "hazard_start_minutes": {
        "default": 5,
        "maximum": 45,
        "minimum": 0,
        "title": "Hazard Start Minutes",
        "type": "integer"
      },
      "highway": {
        "pattern": "^(?:(?:State|US|Interstate) [0-9]{1,3}|osm:(?:ref|name):[0-9a-f]{20}|osm:way:[0-9]+)$",
        "title": "Highway",
        "type": "string"
      },
      "lat": {
        "maximum": 90,
        "minimum": -90,
        "title": "Lat",
        "type": "number"
      },
      "lon": {
        "maximum": 180,
        "minimum": -180,
        "title": "Lon",
        "type": "number"
      },
      "people_per_vehicle": {
        "default": 2,
        "maximum": 8,
        "minimum": 1,
        "title": "People Per Vehicle",
        "type": "integer"
      },
      "policies": {
        "items": {
          "enum": [
            "baseline",
            "coordinated",
            "phased"
          ],
          "type": "string"
        },
        "maxItems": 3,
        "minItems": 1,
        "title": "Policies",
        "type": "array"
      },
      "radius_km": {
        "maximum": 15,
        "minimum": 2,
        "title": "Radius Km",
        "type": "number"
      },
      "seed": {
        "default": 42,
        "maximum": 2147483647,
        "minimum": 0,
        "title": "Seed",
        "type": "integer"
      },
      "traffic_mode": {
        "default": "synthetic",
        "enum": [
          "synthetic",
          "provider_speed_limits"
        ],
        "title": "Traffic Mode",
        "type": "string"
      },
      "vehicles": {
        "default": 400,
        "maximum": 1500,
        "minimum": 20,
        "title": "Vehicles",
        "type": "integer"
      }
    },
    "required": [
      "lat",
      "lon",
      "radius_km",
      "highway",
      "exit_direction"
    ],
    "title": "SimulationScenario",
    "type": "object"
