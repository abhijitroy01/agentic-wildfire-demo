  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/exposure/assessments": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExposureAssessmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentResult"
                }
              }
            },
            "description": "Completed illustrative assessment"
          }
        },
        "security": [
          {
            "serviceKey": []
          }
        ]
      }
    },
    "/v1/landscape/assessments": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
