              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentResult"
                }
              }
            },
            "description": "Completed terrain and fuel scenario or typed failure"
          }
        },
        "security": [
          {
            "serviceKey": []
          }
        ]
      }
    }
  }
