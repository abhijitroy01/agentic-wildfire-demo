# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.*
ui/.env

# Runtime environment files (contain secrets)
backend/runtime/.env.base
backend/runtime/.env.gateway
backend/runtime/.env.deployment
backend/runtime/deployment/state/

# Environment Variable Backups
*.env.backup
.env.backup
backend/.env.backup
backend/.env.env.backup
ui/.env.backup
backend/runtime/deployment/state/backups/*

# Generated files (auto-generated at Docker build time from api-schema.yaml)
backend/runtime/schemas/generated_models.py

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.env/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Deploy-time virtualenvs (provisioned by the deployment scripts to run
# host-side Python steps reproducibly; never committed, never packaged).
deployment/.venv/
broadcastify/deployment/.venv/

# Local runtime state: simulator jobs/networks, deployment receipts and locks.
.runtime/

# CDK app: synthesized output is per-run (see the lib/ exception at the end of this file).
deployment/infra/cdk.out/
# CDK context lookups (Availability Zones) are cached per AWS account when a deploy synthesizes; offline synth needs
# none, so the cache, which names the account, stays out of the repository (D11).
deployment/infra/cdk.context.json

# AWS
.aws/
*.pem

# Bedrock AgentCore SDK Configuration (auto-generated by deployments)
# Contains deployment-specific values (account, region, ARNs) that vary per developer/deployment
# Auto-created and updated by deploy.py after each deployment
backend/runtime/.bedrock_agentcore.yaml

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp

# Node.js (for UI)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript build cache
*.tsbuildinfo

# Build outputs
/build
/dist

# Coverage reports
coverage/
.coverage
.coverage.*
coverage.lcov

# Deployment artifacts
*.zip
*.tar.gz

# Gateway deployment specific
backend/gateway/deployment/logs/
backend/gateway/deployment/deployment_summary.json
backend/gateway/deployment/deployment_*.log
backend/gateway/deployment/backups/state_backup_*.json

# Lambda deployment artifacts and dependencies
backend/gateway/weather/*.zip
backend/gateway/weather/*.tar.gz
backend/gateway/wildfire/*.zip
backend/gateway/wildfire/*.tar.gz
backend/gateway/geocode/*.zip
backend/gateway/geocode/*.tar.gz

# Lambda Python dependencies (keep source files, exclude installed packages)
backend/gateway/weather/*/
backend/gateway/weather/*-*.dist-info/
backend/gateway/weather/bin/
backend/gateway/weather/typing_extensions.py
backend/gateway/wildfire/*/
backend/gateway/wildfire/*-*.dist-info/
backend/gateway/wildfire/bin/
backend/gateway/geocode/*/
backend/gateway/geocode/*-*.dist-info/
backend/gateway/geocode/bin/

# Keep Lambda source files (these should be tracked)
!backend/gateway/weather/lambda_*.py
!backend/gateway/weather/requirements.txt
!backend/gateway/weather/*.yaml
!backend/gateway/weather/*.yml
!backend/gateway/weather/*.json
!backend/gateway/wildfire/lambda_*.py
!backend/gateway/wildfire/requirements.txt
!backend/gateway/wildfire/*.yaml
!backend/gateway/wildfire/*.yml
!backend/gateway/wildfire/*.json
!backend/gateway/geocode/lambda_*.py
!backend/gateway/geocode/requirements.txt
!backend/gateway/geocode/*.yaml
!backend/gateway/geocode/*.yml
!backend/gateway/geocode/*.json

wfm.code-workspace

# Temporary documentation files
*SUMMARY.md
*_TASKS.md
deployment_log.txt

# Kiro configuration (IDE-specific); the quality-loop scanner declaration and project steering are shared.
.kiro/*
!.kiro/quality-loop.json
!.kiro/steering/
# Local third-party reference documents; never redistributed.
knowledge-base-docs/
backend/deployment/credential_provider_arns.json

# Installation files: one installation's identity and choices (copy deployment/installation.example.toml).
deployment/installation.toml
deployment/installations/

# Keep last: the Python "lib/" rule above must not hide the CDK TypeScript sources.
!deployment/infra/lib/
