# =============================================================================
# Fire Truck Simulator - local settings template
# =============================================================================
# Copy this file to firetruck-simulator/.env for a local run. Settings
# (config/settings.py) rejects any key it does not declare, so this file lists
# only its fields (tests/test_settings.py loads it). Every other default lives
# in config/settings.py, and the operational limits in deployment/settings.toml.
# DEBUG and HOST were removed (FTRK-3), and LOG_LEVEL and CORS_ORIGINS with the
# local REST API (FTRK-1); delete them from a .env copied from an older template.

# Local or deployed behavior. "ecs" is set by the stack
# (deployment/infra/lib/stacks.ts), together with the run table, the evidence
# bucket and the service key that ECS requires.
ENVIRONMENT=local

# Operational limits (FIRETRUCK_EVIDENCE_EVENTS_MAX, FIRETRUCK_RUN_LIFETIME_MINUTES and
# FIRETRUCK_RUNS_PER_TASK) default to deployment/settings.toml. Set one here only to override it
# for a local run.
