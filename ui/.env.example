# Public values only. AWS and provider credentials stay in the server environment.
# Production: describe the installation in deployment/installation.toml and run deployment/deploy-all.sh.
# The UI discovers access mode and service bindings from /simulation-api/v1/workspace-config.
VITE_EVACUATION_ENABLED=true

# Local Vite proxy target (not exposed to browser JavaScript).
SIMULATION_LOCAL_URL=http://127.0.0.1:8000
